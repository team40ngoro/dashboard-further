<%- include('../layouts/header', { title: title }) %>
<%- include('../layouts/navbar', { activePage: 'dashboard' }) %>

<main class="main-content">
  <!-- Page Header -->
  <div class="content-header">
    <h1 class="page-title">Dashboard Pengendalian Produk</h1>
    <p class="page-subtitle">Pemantauan menyeluruh volume produksi, pemakaian bahan baku, dan seluruh parameter proses mesin Food Division.</p>
  </div>

  <!-- Interactive Global Filters Toolbar -->
  <div class="card filter-card mb-4">
    <form id="dashboard-filter-form" class="filter-form">
      <% if (isCentralUser) { %>
        <div class="filter-col">
          <label for="branchId" class="filter-label">Cabang</label>
          <select name="branchId" id="branchId" class="form-select">
            <option value="">Semua Cabang (Agregat)</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= (filters.branchId == b.id) ? 'selected' : '' %>><%= b.code %> - <%= b.name %></option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <div class="filter-col">
        <label for="startDate" class="filter-label">Tanggal Awal</label>
        <input type="date" name="startDate" id="startDate" class="form-input" value="<%= filters.startDate %>">
      </div>

      <div class="filter-col">
        <label for="endDate" class="filter-label">Tanggal Akhir</label>
        <input type="date" name="endDate" id="endDate" class="form-input" value="<%= filters.endDate %>">
      </div>

      <div class="filter-col">
        <label for="productCode" class="filter-label">Produk</label>
        <input type="text" name="productCode" id="productCode" class="form-input" placeholder="Kode atau nama produk" value="<%= filters.productCode %>">
      </div>

      <div class="filter-col">
        <label for="line" class="filter-label">Lini Produksi</label>
        <select name="line" id="line" class="form-select">
          <option value="">Semua Lini</option>
          <option value="Line 1" <%= filters.line === 'Line 1' ? 'selected' : '' %>>Line 1</option>
          <option value="Line 2" <%= filters.line === 'Line 2' ? 'selected' : '' %>>Line 2</option>
          <option value="Line 3" <%= filters.line === 'Line 3' ? 'selected' : '' %>>Line 3</option>
        </select>
      </div>

      <div class="filter-col filter-actions">
        <button type="submit" class="btn btn-secondary">Terapkan Filter</button>
      </div>
    </form>
  </div>

  <!-- KPI Summary Cards -->
  <div class="kpi-grid mb-4">
    <div class="kpi-card">
      <div class="kpi-label">TOTAL BATCH DIPROSES</div>
      <div class="kpi-value text-primary" id="kpi-total-batches"><%= metrics.kpis.totalBatches %></div>
      <div class="kpi-sub">Laporan LPP terverifikasi</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">TOTAL BAHAN BAKU</div>
      <div class="kpi-value" id="kpi-total-material"><%= metrics.kpis.totalMaterialKg.toLocaleString('id-ID') %> kg</div>
      <div class="kpi-sub">Total input adonan & material</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">TOTAL FINISHED GOODS</div>
      <div class="kpi-value text-success" id="kpi-total-output"><%= metrics.kpis.totalOutputKg.toLocaleString('id-ID') %> kg</div>
      <div class="kpi-sub">Produk kemasan jadi siap kirim</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">EFISIENSI RENDEMEN</div>
      <div class="kpi-value <%= (metrics.kpis.globalYieldPct >= 95) ? 'text-primary' : 'text-warning' %>" id="kpi-yield-pct">
        <%= metrics.kpis.globalYieldPct %>%
      </div>
      <div class="kpi-sub" id="kpi-total-reject">Rasio rijek: <%= metrics.kpis.globalRejectPct %>% (<%= metrics.kpis.totalRejectKg.toLocaleString('id-ID') %> kg)</div>
    </div>
  </div>

  <!-- SECTION A: Ringkasan Produksi & Bahan Baku (3 Compact Cards) -->
  <div class="dashboard-section-heading">
    <span class="section-tag">Bagian A</span>
    <h2 class="section-title-text">Volume Produksi dan Komposisi Bahan Baku</h2>
  </div>

  <div class="grid-3-cols mb-4">
    <div class="compact-chart-card">
      <div class="card-header">
        <h3 class="card-title">Finished Goods vs Bahan Baku (Kg)</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartOutputTrend"></canvas>
        </div>
      </div>
    </div>

    <div class="compact-chart-card">
      <div class="card-header">
        <h3 class="card-title">Komposisi Bahan Baku Utama</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartMaterialsComposition"></canvas>
        </div>
      </div>
    </div>

    <div class="compact-chart-card">
      <div class="card-header">
        <h3 class="card-title">Tren Efisiensi Rendemen per Batch (%)</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartProductionYield"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION B: Parameter Mesin & Pengendalian Proses (6 Compact Cards) -->
  <div class="dashboard-section-heading">
    <span class="section-tag">Bagian B</span>
    <h2 class="section-title-text">Parameter Mesin dan Pengendalian Suhu Proses</h2>
  </div>

  <div class="grid-3-cols mb-4">
    <!-- 1. Suhu Ruang & Area Kritis -->
    <div class="compact-chart-card">
      <div class="card-header">
        <h3 class="card-title">Suhu Ruang & Area Kritis (°C)</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartTempCritical"></canvas>
        </div>
      </div>
    </div>

    <!-- 2. Mixer & Preparasi Adonan -->
    <div class="compact-chart-card">
      <div class="card-header">
        <h3 class="card-title">Mixer & Bowl Cutter (Suhu & RPM)</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartMixerPrep"></canvas>
        </div>
      </div>
    </div>

    <!-- 3. Penggorengan / Fryer -->
    <div class="compact-chart-card">
      <div class="card-header">
        <h3 class="card-title">Penggorengan / Fryer (°C & TPM)</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartFryerMetrics"></canvas>
        </div>
      </div>
    </div>

    <!-- 4. Stasiun Batter -->
    <div class="compact-chart-card">
      <div class="card-header">
        <h3 class="card-title">Stasiun Batter (Suhu, Viskositas, Garam)</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartBatterStation"></canvas>
        </div>
      </div>
    </div>

    <!-- 5. HLT Continuous Cooker -->
    <div class="compact-chart-card">
      <div class="card-header">
        <h3 class="card-title">HLT Pemasakan Daging (°C)</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartHltMetrics"></canvas>
        </div>
      </div>
    </div>

    <!-- 6. Forming & Revo -->
    <div class="compact-chart-card">
      <div class="card-header">
        <h3 class="card-title">Mesin Forming & Revo (Speed & Bar)</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartFormingMetrics"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Batches Summary Table -->
  <div class="card mb-4">
    <div class="card-header flex-between">
      <h3 class="card-title">Tabel Ringkasan Batch (Sinkron dengan Filter)</h3>
      <a href="/batches" class="btn btn-sm btn-outline-secondary">Lihat Seluruh Batch</a>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="data-table" id="dashboard-batches-table">
          <thead>
            <tr>
              <th>No. Batch</th>
              <th>Tanggal</th>
              <th>Cabang</th>
              <th>Produk</th>
              <th>Lini</th>
              <th class="text-right">Bahan (Kg)</th>
              <th class="text-right">Finished Goods (Kg)</th>
              <th class="text-right">% Rendemen</th>
              <th class="text-right">% Rijek</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (metrics.batchesSummaryTable.length === 0) { %>
              <tr>
                <td colspan="10" class="text-center py-6 text-muted">
                  Tidak ada batch yang ditemukan untuk kriteria filter saat ini.
                </td>
              </tr>
            <% } %>
            <% metrics.batchesSummaryTable.forEach(b => { 
                const matKg = Number(b.total_material_kg) || 0;
                const outKg = Number(b.output_good_kg) || 0;
                const yieldRate = matKg > 0 ? ((outKg / matKg) * 100).toFixed(1) : 0;
            %>
              <tr>
                <td class="font-bold text-primary">
                  <a href="/batches/<%= b.id %>" class="table-link"><%= b.batch_number %></a>
                </td>
                <td><%= typeof b.production_date === 'string' ? b.production_date.split('T')[0] : (b.production_date ? b.production_date.toISOString().split('T')[0] : '-') %></td>
                <td><span class="badge badge-branch"><%= b.branch_code || b.branch_name %></span></td>
                <td>
                  <strong><%= b.product_name %></strong>
                  <div class="text-xs text-muted"><%= b.product_code %></div>
                </td>
                <td><%= b.line %></td>
                <td class="text-right"><%= matKg.toLocaleString('id-ID') %></td>
                <td class="text-right font-semibold text-success"><%= outKg.toLocaleString('id-ID') %></td>
                <td class="text-right font-semibold text-primary"><%= yieldRate %>%</td>
                <td class="text-right <%= Number(b.calculated_reject_pct) > 3 ? 'text-danger font-bold' : 'text-muted' %>">
                  <%= b.calculated_reject_pct %>%
                </td>
                <td>
                  <a href="/batches/<%= b.id %>" class="btn btn-sm btn-outline-primary">Detail</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- Hidden initial JSON data for Chart.js bootstrap -->
<script type="application/json" id="initial-dashboard-data">
  <%- initialDataJson %>
</script>
<script src="/js/dashboard.js"></script>

<%- include('../layouts/footer') %>
