<%- include('../layouts/header', { title: title }) %>
<%- include('../layouts/navbar', { activePage: 'dashboard' }) %>

<main class="main-content">
  <!-- Page Header -->
  <div class="content-header flex-between">
    <div>
      <h1 class="page-title">Dashboard Pengendalian Produk</h1>
      <p class="page-subtitle">Monitoring parameter proses aktual, berat bahan baku, dan rasio rijek lintas cabang Food Division.</p>
    </div>
    <div class="header-actions">
      <% if (currentUser.role === 'admin_pusat' || currentUser.role === 'pengunggah_cabang') { %>
        <a href="/upload" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          Unggah LPP
        </a>
      <% } %>
    </div>
  </div>

  <!-- Interactive Filters Toolbar -->
  <div class="card filter-card mb-4">
    <form id="dashboard-filter-form" class="filter-form">
      <% if (isCentralUser) { %>
        <div class="filter-col">
          <label for="branchId" class="filter-label">Cabang</label>
          <select name="branchId" id="branchId" class="form-select">
            <option value="">Semua Cabang (Agregat)</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= (filters.branchId == b.id) ? 'selected' : '' %>><%= b.code %> - <%= b.name %></option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <div class="filter-col">
        <label for="startDate" class="filter-label">Dari Tanggal</label>
        <input type="date" name="startDate" id="startDate" class="form-input" value="<%= filters.startDate %>">
      </div>

      <div class="filter-col">
        <label for="endDate" class="filter-label">Sampai Tanggal</label>
        <input type="date" name="endDate" id="endDate" class="form-input" value="<%= filters.endDate %>">
      </div>

      <div class="filter-col">
        <label for="productCode" class="filter-label">Produk</label>
        <input type="text" name="productCode" id="productCode" class="form-input" placeholder="Kode atau nama produk..." value="<%= filters.productCode %>">
      </div>

      <div class="filter-col">
        <label for="line" class="filter-label">Line Produksi</label>
        <select name="line" id="line" class="form-select">
          <option value="">Semua Line</option>
          <option value="Line 1" <%= filters.line === 'Line 1' ? 'selected' : '' %>>Line 1</option>
          <option value="Line 2" <%= filters.line === 'Line 2' ? 'selected' : '' %>>Line 2</option>
          <option value="Line 3" <%= filters.line === 'Line 3' ? 'selected' : '' %>>Line 3</option>
        </select>
      </div>

      <div class="filter-col">
        <label for="machineParam" class="filter-label">Parameter Mesin</label>
        <select name="machineParam" id="machineParam" class="form-select">
          <option value="">-- Pilih Parameter Mesin --</option>
          <% metrics.availableMachineParams.forEach(p => { %>
            <option value="<%= p.key %>" <%= (filters.machineParam === p.key || (!filters.machineParam && p.key === metrics.charts.machineMetricsTrend?.paramName)) ? 'selected' : '' %>>
              <%= p.key %> (<%= p.unit %>)
            </option>
          <% }) %>
        </select>
      </div>

      <div class="filter-col filter-actions">
        <button type="submit" class="btn btn-secondary">Terapkan Filter</button>
      </div>
    </form>
  </div>

  <!-- KPI Summary Cards -->
  <div class="kpi-grid mb-4">
    <div class="kpi-card">
      <div class="kpi-label">TOTAL BATCH DIPROSES</div>
      <div class="kpi-value text-primary" id="kpi-total-batches"><%= metrics.kpis.totalBatches %></div>
      <div class="kpi-sub">Laporan LPP terverifikasi</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">TOTAL BAHAN BAKU</div>
      <div class="kpi-value" id="kpi-total-material"><%= metrics.kpis.totalMaterialKg.toLocaleString('id-ID') %> kg</div>
      <div class="kpi-sub">Input bahan baku & adonan</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">TOTAL OUTPUT BAIK</div>
      <div class="kpi-value text-success" id="kpi-total-output"><%= metrics.kpis.totalOutputKg.toLocaleString('id-ID') %> kg</div>
      <div class="kpi-sub">Produk kemasan jadi siap kirim</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">RASIO RIJEK GLOBAL</div>
      <div class="kpi-value <%= metrics.kpis.globalRejectPct > 3 ? 'text-danger' : 'text-warning' %>" id="kpi-reject-pct">
        <%= metrics.kpis.globalRejectPct %>%
      </div>
      <div class="kpi-sub" id="kpi-total-reject">Total rijek: <%= metrics.kpis.totalRejectKg.toLocaleString('id-ID') %> kg</div>
    </div>
  </div>

  <!-- Charts Row 1: Output vs Material & Rejects Composition -->
  <div class="charts-grid mb-4">
    <div class="card chart-card">
      <div class="card-header">
        <h3 class="card-title">Tren Output Produk vs Total Bahan Baku</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartOutputTrend"></canvas>
        </div>
      </div>
    </div>

    <div class="card chart-card">
      <div class="card-header">
        <h3 class="card-title">Komposisi Jenis Rijek</h3>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="chartRejectsBreakdown"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row 2: Machine Parameters Actual Trend -->
  <div class="card mb-4">
    <div class="card-header">
      <h3 class="card-title">Tren Nilai Aktual Parameter Mesin (EAV)</h3>
    </div>
    <div class="card-body">
      <div class="chart-container" style="height: 280px;">
        <canvas id="chartMachineTrend"></canvas>
      </div>
    </div>
  </div>

  <!-- Recent Batches Summary Table -->
  <div class="card mb-4">
    <div class="card-header flex-between">
      <h3 class="card-title">Tabel Angka Ringkas Batch (Sinkron dengan Filter)</h3>
      <a href="/batches" class="btn btn-sm btn-outline-secondary">Lihat Seluruh Batch →</a>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="data-table" id="dashboard-batches-table">
          <thead>
            <tr>
              <th>No. Batch</th>
              <th>Tanggal</th>
              <th>Cabang</th>
              <th>Produk</th>
              <th>Line</th>
              <th class="text-right">Bahan (Kg)</th>
              <th class="text-right">Output (Kg)</th>
              <th class="text-right">% Rijek</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (metrics.batchesSummaryTable.length === 0) { %>
              <tr>
                <td colspan="9" class="text-center py-6 text-muted">
                  Tidak ada batch yang ditemukan untuk rentang filter saat ini.
                </td>
              </tr>
            <% } %>
            <% metrics.batchesSummaryTable.forEach(b => { %>
              <tr>
                <td class="font-bold text-primary">
                  <a href="/batches/<%= b.id %>" class="table-link"><%= b.batch_number %></a>
                </td>
                <td><%= typeof b.production_date === 'string' ? b.production_date.split('T')[0] : (b.production_date ? b.production_date.toISOString().split('T')[0] : '-') %></td>
                <td><span class="badge badge-branch"><%= b.branch_code || b.branch_name %></span></td>
                <td>
                  <strong><%= b.product_name %></strong>
                  <div class="text-xs text-muted"><%= b.product_code %></div>
                </td>
                <td><%= b.line %></td>
                <td class="text-right"><%= Number(b.total_material_kg).toLocaleString('id-ID') %></td>
                <td class="text-right font-semibold text-success"><%= Number(b.output_good_kg).toLocaleString('id-ID') %></td>
                <td class="text-right <%= Number(b.calculated_reject_pct) > 3 ? 'text-danger font-bold' : '' %>">
                  <%= b.calculated_reject_pct %>%
                </td>
                <td>
                  <a href="/batches/<%= b.id %>" class="btn btn-sm btn-outline-primary">Detail</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- Hidden initial JSON data for Chart.js bootstrap -->
<script type="application/json" id="initial-dashboard-data">
  <%- initialDataJson %>
</script>
<script src="/js/dashboard.js"></script>

<%- include('../layouts/footer') %>
