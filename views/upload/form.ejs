<%- include('../layouts/header', { title: title }) %>
<%- include('../layouts/navbar', { activePage: 'upload' }) %>

<main class="main-content">
  <div class="content-header">
    <div>
      <h1 class="page-title">Bulk Upload & Validasi Antrean LPP</h1>
      <p class="page-subtitle">Unggah satu atau banyak berkas formulir LPP (.xlsx) sekaligus. Sistem akan memproses dan memvalidasi setiap berkas secara sekuensial satu per satu.</p>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger mb-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <div class="upload-grid">
    <!-- Left Column: Form & Queue System -->
    <div class="card upload-card">
      <div class="card-header flex-between">
        <h2 class="card-title">1. Konfigurasi Cabang & Berkas</h2>
        <span class="badge badge-branch" id="queue-overall-counter">Siap Unggah</span>
      </div>
      <div class="card-body">
        <form id="upload-form">
          
          <div class="grid-2-cols mb-3">
            <div class="form-group">
              <label for="branchId" class="form-label font-semibold">Cabang / Plant Produksi <span class="text-danger">*</span></label>
              <select name="branchId" id="branchId" class="form-select" required>
                <option value="">-- Pilih Cabang --</option>
                <% branches.forEach(b => { %>
                  <option value="<%= b.id %>"><%= b.code %> - <%= b.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="accessCode" class="form-label font-semibold">Kode Akses / PIN Plant <span class="text-danger">*</span></label>
              <div style="position: relative;">
                <input type="password" name="accessCode" id="accessCode" class="form-input" placeholder="PIN Cabang (Default: 1234)" required autocomplete="current-password">
                <button type="button" id="toggle-pin-btn" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-secondary); font-size: 0.8rem; font-weight: 600;">
                  Lihat
                </button>
              </div>
            </div>
          </div>

          <div class="form-group mb-4" style="display: flex; align-items: center; gap: 0.5rem;">
            <input type="checkbox" id="remember-pin" checked style="cursor: pointer; width: 16px; height: 16px;">
            <label for="remember-pin" style="font-size: 0.85rem; color: var(--text-secondary); cursor: pointer; user-select: none;">
              Ingat Cabang & PIN di perangkat ini
            </label>
          </div>

          <!-- Dropzone Area (Supports Multiple Files) -->
          <div class="form-group mb-3">
            <label class="form-label font-semibold">Pilih atau Tarik Berkas Excel LPP (Bisa Banyak File Sekaligus) <span class="text-danger">*</span></label>
            <div class="dropzone-area" id="dropzone">
              <div class="dropzone-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </div>
              <p class="dropzone-title">Tarik satu atau beberapa berkas Excel (.xlsx) ke sini</p>
              <p class="dropzone-sub">Mendukung multi-file bulk upload — <em>Antrean validasi sekuensial otomatis dimulai seketika</em></p>
              <input type="file" name="lppFiles" id="lppFile" accept=".xlsx, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="file-input-hidden" multiple>
            </div>
          </div>
        </form>

        <!-- Dynamic Queue Dashboard (Appears when files are in queue) -->
        <div id="queue-container" class="upload-queue-container" style="display: none;">
          <div class="queue-progress-header">
            <span class="queue-progress-title" id="queue-progress-text">Memproses Antrean (0/0)</span>
            <span class="queue-progress-stats" id="queue-stats-text">0 Sukses | 0 Gagal</span>
          </div>
          <div class="queue-progress-bar-bg">
            <div class="queue-progress-bar-fill" id="queue-progress-bar"></div>
          </div>

          <div class="queue-list" id="queue-items-list">
            <!-- Queue Item Rows Injected by JS -->
          </div>

          <div class="form-actions mt-4 flex-between" id="queue-actions-bar" style="display: none;">
            <button type="button" class="btn btn-outline-secondary" id="btn-reset-queue">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
              Unggah Berkas Lainnya
            </button>
            <a href="/batches" class="btn btn-primary" id="btn-go-batches">
              Lihat Daftar Seluruh Batch →
            </a>
          </div>
        </div>

        <div class="form-actions mt-4 flex-between" id="default-actions-bar">
          <a href="/upload/sample-template" class="btn btn-outline-secondary btn-sm" id="btn-download-sample" download>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Unduh Contoh LPP (.xlsx)
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Rules & Guidance -->
    <div class="card info-card">
      <div class="card-header">
        <h2 class="card-title">Ketentuan Sistem Antrean Bulk</h2>
      </div>
      <div class="card-body">
        <ul class="guideline-list">
          <li>
            <span class="guide-num">1.</span>
            <div>
              <strong>Pemrosesan Sekuensial (Satu per Satu)</strong>
              <p>Setiap file diantrekan dan divalidasi satu per satu ke server. Anda dapat melihat status progress secara langsung per file.</p>
            </div>
          </li>
          <li>
            <span class="guide-num">2.</span>
            <div>
              <strong>Toleransi Kesalahan Mandiri (*Fault-Isolated*)</strong>
              <p>Jika berkas ke-2 memiliki kesalahan (misal nomor batch duplikat atau kolom kosong), sistem menandainya <strong>Gagal</strong> dan langsung <strong>melanjutkan pemrosesan berkas ke-3</strong> tanpa membatalkan seluruh antrean.</p>
            </div>
          </li>
          <li>
            <span class="guide-num">3.</span>
            <div>
              <strong>Penyimpanan Otomatis Atomik</strong>
              <p>Setiap berkas yang lolos validasi langsung disimpan ke basis data secara permanen lengkap dengan nomor batch dan perhitungan rendemen.</p>
            </div>
          </li>
          <li>
            <span class="guide-num">4.</span>
            <div>
              <strong>Pemeriksaan Rincian Kesalahan</strong>
              <p>Pada berkas yang gagal, klik tombol <strong>"Lihat Kesalahan"</strong> untuk melihat daftar sel dan aturan yang tidak terpenuhi.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</main>

<script>
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('lppFile');
  const branchSelect = document.getElementById('branchId');
  const pinInput = document.getElementById('accessCode');
  const rememberPin = document.getElementById('remember-pin');
  const togglePinBtn = document.getElementById('toggle-pin-btn');

  const queueContainer = document.getElementById('queue-container');
  const queueItemsList = document.getElementById('queue-items-list');
  const queueProgressBar = document.getElementById('queue-progress-bar');
  const queueProgressText = document.getElementById('queue-progress-text');
  const queueStatsText = document.getElementById('queue-stats-text');
  const queueActionsBar = document.getElementById('queue-actions-bar');
  const queueOverallCounter = document.getElementById('queue-overall-counter');
  const btnResetQueue = document.getElementById('btn-reset-queue');

  let isProcessingQueue = false;
  let queueFiles = [];
  let fileErrorCache = {};

  // Auto-fill from localStorage
  try {
    const savedBranch = localStorage.getItem('cp_lpp_branch_id');
    const savedPin = localStorage.getItem('cp_lpp_access_pin');
    if (savedBranch && branchSelect) branchSelect.value = savedBranch;
    if (savedPin && pinInput) pinInput.value = savedPin;
  } catch (e) {}

  function savePinPreference() {
    try {
      if (rememberPin && rememberPin.checked) {
        localStorage.setItem('cp_lpp_branch_id', branchSelect.value);
        localStorage.setItem('cp_lpp_access_pin', pinInput.value);
      } else {
        localStorage.removeItem('cp_lpp_branch_id');
        localStorage.removeItem('cp_lpp_access_pin');
      }
    } catch (e) {}
  }

  // Toggle PIN visibility
  if (togglePinBtn && pinInput) {
    togglePinBtn.addEventListener('click', () => {
      if (pinInput.type === 'password') {
        pinInput.type = 'text';
        togglePinBtn.textContent = 'Sembunyikan';
      } else {
        pinInput.type = 'password';
        togglePinBtn.textContent = 'Lihat';
      }
    });
  }

  // Format File Size
  function formatBytes(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  // Initialize and run sequential queue
  async function handleFilesSelected(fileList) {
    if (!fileList || fileList.length === 0) return;

    if (isProcessingQueue) {
      if (window.AppAlert) {
        window.AppAlert.warning('Antrean Sedang Berjalan', 'Harap tunggu hingga seluruh antrean berkas saat ini selesai diproses.');
      }
      return;
    }

    // 1. Validate Branch
    if (!branchSelect.value) {
      fileInput.value = '';
      if (window.AppAlert) {
        window.AppAlert.warning(
          'Pilih Cabang / Plant',
          'Silakan pilih Cabang / Plant produksi terlebih dahulu sebelum mengunggah berkas.',
          'branchId'
        );
      }
      return;
    }

    // 2. Validate PIN
    if (!pinInput.value || pinInput.value.trim() === '') {
      fileInput.value = '';
      if (window.AppAlert) {
        window.AppAlert.warning(
          'Kode Akses / PIN Diperlukan',
          'Silakan masukkan Kode Akses / PIN Plant untuk cabang yang dipilih.',
          'accessCode'
        );
      }
      return;
    }

    savePinPreference();

    // Prepare queue
    queueFiles = Array.from(fileList);
    fileErrorCache = {};
    isProcessingQueue = true;
    dropzone.style.pointerEvents = 'none';
    dropzone.style.opacity = '0.6';

    // Render initial queue UI
    queueContainer.style.display = 'block';
    queueActionsBar.style.display = 'none';
    queueItemsList.innerHTML = '';
    queueOverallCounter.textContent = `${queueFiles.length} Berkas dalam Antrean`;
    queueOverallCounter.className = 'badge badge-setting';

    queueFiles.forEach((file, idx) => {
      const itemEl = document.createElement('div');
      itemEl.className = 'queue-item';
      itemEl.id = `queue-item-${idx}`;
      itemEl.innerHTML = `
        <div class="queue-item-header">
          <div class="queue-item-name">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            <span>${file.name}</span>
            <span class="queue-item-size">(${formatBytes(file.size)})</span>
          </div>
          <span class="queue-badge badge-waiting" id="badge-${idx}">⏳ Menunggu antrean</span>
        </div>
        <div class="queue-item-body" id="body-${idx}">
          <span class="text-muted">Siap diproses...</span>
        </div>
      `;
      queueItemsList.appendChild(itemEl);
    });

    // Start Sequential Worker
    let successCount = 0;
    let failedCount = 0;
    const totalFiles = queueFiles.length;

    for (let i = 0; i < totalFiles; i++) {
      const currentFile = queueFiles[i];
      const itemEl = document.getElementById(`queue-item-${i}`);
      const badgeEl = document.getElementById(`badge-${i}`);
      const bodyEl = document.getElementById(`body-${i}`);

      // Update current status to processing
      itemEl.className = 'queue-item status-processing';
      badgeEl.className = 'queue-badge badge-processing';
      badgeEl.innerHTML = '🔄 Memvalidasi & Mengimpor...';
      bodyEl.innerHTML = '<span style="color: #b45309;">Sedang membaca lembar kerja Excel dan memvalidasi aturan...</span>';

      // Update progress bar
      queueProgressText.textContent = `Memproses berkas ${i + 1} dari ${totalFiles}: ${currentFile.name}`;
      queueStatsText.textContent = `${successCount} Sukses | ${failedCount} Gagal`;
      queueProgressBar.style.width = `${((i) / totalFiles) * 100}%`;

      // Scroll into view
      itemEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      try {
        const formData = new FormData();
        formData.append('branchId', branchSelect.value);
        formData.append('accessCode', pinInput.value);
        formData.append('lppFile', currentFile);

        const response = await fetch('/upload/process-queue-item', {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: formData
        });

        const result = await response.json();

        if (response.ok && result.success) {
          // Success
          successCount++;
          itemEl.className = 'queue-item status-success';
          badgeEl.className = 'queue-badge badge-success';
          badgeEl.innerHTML = '✅ Sukses Terimpor';

          bodyEl.innerHTML = `
            <div class="queue-item-details">
              <span><strong>Batch:</strong> ${result.batchNumber || '-'}</span>
              <span><strong>Produk:</strong> ${result.productName || '-'}</span>
              <span><strong>Lini:</strong> ${result.line || '-'}</span>
              <span><strong>Bahan:</strong> ${Number(result.totalMaterialKg || 0).toLocaleString('id-ID')} kg</span>
              <span><strong>Finished Goods:</strong> ${Number(result.outputGoodKg || 0).toLocaleString('id-ID')} kg</span>
            </div>
            <a href="/batches/${result.batchId}" target="_blank" class="table-link font-semibold">
              Buka Rincian Batch ↗
            </a>
          `;
        } else {
          // Failure
          failedCount++;
          itemEl.className = 'queue-item status-failed';
          badgeEl.className = 'queue-badge badge-failed';
          badgeEl.innerHTML = '❌ Gagal Validasi';

          const errors = result.errors || [result.message || 'Kesalahan validasi template'];
          const warnings = result.warnings || [];
          fileErrorCache[i] = { fileName: currentFile.name, errors, warnings };

          const primaryError = errors[0] || 'Validasi tidak terpenuhi';
          bodyEl.innerHTML = `
            <span class="queue-error-preview">${primaryError}${errors.length > 1 ? ` (+${errors.length - 1} kesalahan lainnya)` : ''}</span>
            <button type="button" class="btn-view-errors" onclick="showFileErrors(${i})">
              Lihat ${errors.length} Kesalahan
            </button>
          `;
        }
      } catch (networkErr) {
        failedCount++;
        itemEl.className = 'queue-item status-failed';
        badgeEl.className = 'queue-badge badge-failed';
        badgeEl.innerHTML = '❌ Gagal Jaringan';
        fileErrorCache[i] = { fileName: currentFile.name, errors: [networkErr.message], warnings: [] };
        bodyEl.innerHTML = `
          <span class="queue-error-preview">Kesalahan jaringan: ${networkErr.message}</span>
          <button type="button" class="btn-view-errors" onclick="showFileErrors(${i})">Lihat Rincian</button>
        `;
      }

      // Update progress bar to include completed item
      queueProgressBar.style.width = `${((i + 1) / totalFiles) * 100}%`;
      queueStatsText.textContent = `${successCount} Sukses | ${failedCount} Gagal`;
    }

    // Finished entire queue
    isProcessingQueue = false;
    dropzone.style.pointerEvents = 'auto';
    dropzone.style.opacity = '1';
    queueProgressText.textContent = `Selesai Memproses ${totalFiles} Berkas`;
    queueProgressBar.style.width = '100%';
    queueActionsBar.style.display = 'flex';

    if (failedCount === 0) {
      queueOverallCounter.textContent = `${successCount}/${totalFiles} Berhasil`;
      queueOverallCounter.className = 'badge badge-actual';
      if (window.AppAlert) {
        window.AppAlert.success(
          'Seluruh Berkas Berhasil Diimpor!',
          `Semua ${successCount} berkas LPP berhasil divalidasi dan disimpan permanen ke basis data.`,
          0
        );
      }
    } else {
      queueOverallCounter.textContent = `${successCount} Berhasil, ${failedCount} Gagal`;
      queueOverallCounter.className = 'badge badge-branch';
      if (window.AppAlert) {
        window.AppAlert.warning(
          'Pemrosesan Antrean Selesai',
          `${successCount} berkas berhasil diimpor, ${failedCount} berkas gagal divalidasi. Anda dapat memeriksa rincian kegagalan pada setiap berkas di daftar antrean.`
        );
      }
    }
  }

  // Global handler for viewing cached file validation errors
  window.showFileErrors = function (idx) {
    const data = fileErrorCache[idx];
    if (data && window.AppAlert) {
      window.AppAlert.validationErrors(`Kesalahan Berkas: ${data.fileName}`, data.errors, data.warnings);
    }
  };

  // Reset queue button
  if (btnResetQueue) {
    btnResetQueue.addEventListener('click', () => {
      queueContainer.style.display = 'none';
      queueItemsList.innerHTML = '';
      queueFiles = [];
      fileErrorCache = {};
      fileInput.value = '';
      queueOverallCounter.textContent = 'Siap Unggah';
      queueOverallCounter.className = 'badge badge-branch';
    });
  }

  // Dropzone click
  dropzone.addEventListener('click', () => {
    if (!isProcessingQueue) fileInput.click();
  });

  // Input change trigger
  fileInput.addEventListener('change', () => {
    if (fileInput.files.length > 0) {
      handleFilesSelected(fileInput.files);
    }
  });

  // Drag & drop triggers
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    if (!isProcessingQueue) dropzone.classList.add('dragover');
  });

  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('dragover');
  });

  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dragover');
    if (!isProcessingQueue && e.dataTransfer.files.length > 0) {
      handleFilesSelected(e.dataTransfer.files);
    }
  });
</script>

<%- include('../layouts/footer') %>
