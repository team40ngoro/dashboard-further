<%- include('../layouts/header', { title: title }) %>
<%- include('../layouts/navbar', { activePage: 'batches' }) %>

<main class="main-content">
  <div class="content-header">
    <div class="breadcrumb mb-2">
      <a href="/batches/<%= batch.id %>" class="text-muted">← Kembali ke Rincian Batch</a>
    </div>
    <h1 class="page-title">Koreksi Data Batch: <%= batch.batch_number %></h1>
    <p class="page-subtitle">Setiap perubahan akan dicatat secara permanen pada riwayat audit untuk kepatuhan Quality Assurance.</p>
  </div>

  <% if (errorMessage) { %>
    <div class="alert alert-danger mb-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span><%= errorMessage %></span>
    </div>
  <% } %>

  <div class="card max-w-2xl">
    <div class="card-header">
      <h3 class="card-title">Formulir Koreksi Data Batch</h3>
    </div>
    <div class="card-body">
      <form action="/batches/<%= batch.id %>/edit" method="POST">
        <div class="form-group mb-3">
          <label for="productName" class="form-label font-semibold">Nama Produk</label>
          <input type="text" name="productName" id="productName" class="form-input" value="<%= batch.product_name %>" required>
        </div>

        <div class="grid-2-cols mb-3">
          <div class="form-group">
            <label for="line" class="form-label font-semibold">Lini Produksi</label>
            <input type="text" name="line" id="line" class="form-input" value="<%= batch.line %>" required>
          </div>
          <div class="form-group">
            <label for="workHours" class="form-label font-semibold">Waktu Kerja (jam)</label>
            <input type="number" step="0.1" name="workHours" id="workHours" class="form-input" value="<%= batch.work_hours %>">
          </div>
        </div>

        <div class="form-group mb-3">
          <label for="meatPercentage" class="form-label font-semibold">% Total Meat</label>
          <input type="number" step="0.1" name="meatPercentage" id="meatPercentage" class="form-input" value="<%= batch.meat_percentage %>">
        </div>

        <div class="form-group mb-4">
          <label for="reason" class="form-label font-semibold text-danger">Alasan Koreksi (Wajib diisi untuk catatan audit)</label>
          <textarea name="reason" id="reason" class="form-textarea" rows="3" placeholder="Contoh: Penyesuaian nama produk berdasarkan instruksi revisi QC..." required></textarea>
        </div>

        <div class="form-actions flex-between">
          <a href="/batches/<%= batch.id %>" class="btn btn-outline-secondary">Batal</a>
          <button type="submit" class="btn btn-primary">
            Simpan Perubahan dan Catat Audit
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
