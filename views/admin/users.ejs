<%- include('../layouts/header', { title: title }) %>
<%- include('../layouts/navbar', { activePage: 'users' }) %>

<main class="main-content">
  <div class="content-header">
    <h1 class="page-title">Manajemen Akun Pengguna</h1>
    <p class="page-subtitle">Kelola hak akses peran (RBAC) dan penugasan cabang untuk akun operator serta analis.</p>
  </div>

  <% if (successMessage) { %>
    <div class="alert alert-success mb-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span><%= successMessage %></span>
    </div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger mb-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span><%= errorMessage %></span>
    </div>
  <% } %>

  <div class="upload-grid">
    <!-- Form Tambah User -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Buat Pengguna Baru</h3>
      </div>
      <div class="card-body">
        <form action="/admin/users" method="POST">
          <div class="form-group mb-3">
            <label for="username" class="form-label font-semibold">Nama Pengguna (Username)</label>
            <input type="text" name="username" id="username" class="form-input" placeholder="Contoh: uploader.medan" required>
          </div>

          <div class="form-group mb-3">
            <label for="fullName" class="form-label font-semibold">Nama Lengkap</label>
            <input type="text" name="fullName" id="fullName" class="form-input" placeholder="Contoh: Budi Santoso" required>
          </div>

          <div class="form-group mb-3">
            <label for="password" class="form-label font-semibold">Kata Sandi</label>
            <input type="password" name="password" id="password" class="form-input" placeholder="Masukkan kata sandi baru" required>
          </div>

          <div class="form-group mb-3">
            <label for="role" class="form-label font-semibold">Peran dan Hak Akses</label>
            <select name="role" id="role" class="form-select" required>
              <option value="<%= roles.PENGUNGGAH_CABANG %>"><%= roleLabels.pengunggah_cabang %></option>
              <option value="<%= roles.PEMBACA_CABANG %>"><%= roleLabels.pembaca_cabang %></option>
              <option value="<%= roles.ANALIS_PUSAT %>"><%= roleLabels.analis_pusat %></option>
              <option value="<%= roles.ADMIN_PUSAT %>"><%= roleLabels.admin_pusat %></option>
            </select>
          </div>

          <div class="form-group mb-4" id="branch-select-group">
            <label for="branchId" class="form-label font-semibold">Cabang Penugasan</label>
            <select name="branchId" id="branchId" class="form-select">
              <option value="">Tidak Ada (Kantor Pusat)</option>
              <% branches.forEach(b => { %>
                <option value="<%= b.id %>"><%= b.code %> - <%= b.name %></option>
              <% }) %>
            </select>
            <small class="form-hint">Wajib dipilih untuk peran Pengunggah dan Pembaca Cabang.</small>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Buat Akun Pengguna
          </button>
        </form>
      </div>
    </div>

    <!-- Tabel Daftar Pengguna -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Daftar Pengguna Sistem (<%= users.length %>)</h3>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Username</th>
                <th>Nama Lengkap</th>
                <th>Peran</th>
                <th>Cabang</th>
                <th>Status</th>
                <th class="text-center" style="width: 140px;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
                <tr>
                  <td class="font-bold"><code><%= u.username %></code></td>
                  <td><%= u.full_name %></td>
                  <td><span class="badge badge-stage"><%= roleLabels[u.role] || u.role.replace('_', ' ') %></span></td>
                  <td>
                    <% if (u.branch_name) { %>
                      <span class="badge badge-branch"><%= u.branch_code %></span> <%= u.branch_name %>
                    <% } else { %>
                      <span class="text-muted font-medium">🏢 Kantor Pusat</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (u.is_active) { %>
                      <span class="badge badge-status-good">Aktif</span>
                    <% } else { %>
                      <span class="badge badge-status-high">Nonaktif</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="table-actions-cell justify-center">
                      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openEditUserModal(<%= u.id %>, '<%= u.username.replace(/'/g, "\\'") %>', '<%= u.full_name.replace(/'/g, "\\'") %>', '<%= u.role %>', '<%= u.branch_id || '' %>', <%= u.is_active ? 1 : 0 %>)" title="Edit Pengguna">
                        Edit
                      </button>
                      <% if (user && user.id === u.id) { %>
                        <button type="button" class="btn btn-sm btn-outline-secondary opacity-50 cursor-not-allowed" disabled title="Akun Anda Sendiri">
                          Anda
                        </button>
                      <% } else { %>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDeleteUser(<%= u.id %>, '<%= u.username.replace(/'/g, "\\'") %>', '<%= u.full_name.replace(/'/g, "\\'") %>')" title="Hapus Pengguna">
                          Hapus
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Hidden Form for Delete -->
<form id="deleteUserForm" method="POST" style="display: none;"></form>

<!-- Modal Edit Pengguna -->
<div class="modal-backdrop" id="editUserModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Edit Data Pengguna</h3>
      <button type="button" class="modal-close-btn" onclick="closeEditUserModal()">&times;</button>
    </div>
    <form id="editUserForm" method="POST">
      <div class="modal-body">
        <div class="form-group mb-3">
          <label for="edit_username" class="form-label font-semibold">Nama Pengguna (Username)</label>
          <input type="text" name="username" id="edit_username" class="form-input" required>
        </div>

        <div class="form-group mb-3">
          <label for="edit_fullName" class="form-label font-semibold">Nama Lengkap</label>
          <input type="text" name="fullName" id="edit_fullName" class="form-input" required>
        </div>

        <div class="form-group mb-3">
          <label for="edit_password" class="form-label font-semibold">Kata Sandi Baru</label>
          <input type="password" name="password" id="edit_password" class="form-input" placeholder="Kosongkan jika tidak ingin mengubah password">
          <div class="text-xs text-muted mt-1">Biarkan kosong bila kata sandi tetap sama.</div>
        </div>

        <div class="form-group mb-3">
          <label for="edit_role" class="form-label font-semibold">Peran dan Hak Akses</label>
          <select name="role" id="edit_role" class="form-select" required onchange="handleRoleChange('edit_role', 'edit_branch-group')">
            <option value="<%= roles.PENGUNGGAH_CABANG %>"><%= roleLabels.pengunggah_cabang %></option>
            <option value="<%= roles.PEMBACA_CABANG %>"><%= roleLabels.pembaca_cabang %></option>
            <option value="<%= roles.ANALIS_PUSAT %>"><%= roleLabels.analis_pusat %></option>
            <option value="<%= roles.ADMIN_PUSAT %>"><%= roleLabels.admin_pusat %></option>
          </select>
        </div>

        <div class="form-group mb-3" id="edit_branch-group">
          <label for="edit_branchId" class="form-label font-semibold">Cabang Penugasan</label>
          <select name="branchId" id="edit_branchId" class="form-select">
            <option value="">Tidak Ada (Kantor Pusat)</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>"><%= b.code %> - <%= b.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group mb-2">
          <label for="edit_isActive" class="form-label font-semibold">Status Akun</label>
          <select name="isActive" id="edit_isActive" class="form-select">
            <option value="1">Aktif (Dapat Login)</option>
            <option value="0">Nonaktif (Diblokir)</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="closeEditUserModal()">Batal</button>
        <button type="submit" class="btn btn-primary btn-sm">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function handleRoleChange(roleSelectId, branchGroupId) {
    const roleVal = document.getElementById(roleSelectId).value;
    const branchGroup = document.getElementById(branchGroupId);
    const branchSelect = branchGroup.querySelector('select');
    if (roleVal === '<%= roles.ADMIN_PUSAT %>' || roleVal === '<%= roles.ANALIS_PUSAT %>') {
      branchSelect.value = '';
      branchGroup.style.opacity = '0.5';
    } else {
      branchGroup.style.opacity = '1';
    }
  }

  document.getElementById('role').addEventListener('change', function() {
    handleRoleChange('role', 'branch-select-group');
  });

  function openEditUserModal(id, username, fullName, role, branchId, isActive) {
    const modal = document.getElementById('editUserModal');
    const form = document.getElementById('editUserForm');
    form.action = `/admin/users/${id}/update`;
    document.getElementById('edit_username').value = username;
    document.getElementById('edit_fullName').value = fullName;
    document.getElementById('edit_password').value = '';
    document.getElementById('edit_role').value = role;
    document.getElementById('edit_branchId').value = branchId || '';
    document.getElementById('edit_isActive').value = isActive ? '1' : '0';
    handleRoleChange('edit_role', 'edit_branch-group');
    modal.classList.add('active');
  }

  function closeEditUserModal() {
    const modal = document.getElementById('editUserModal');
    modal.classList.remove('active');
  }

  document.getElementById('editUserModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeEditUserModal();
    }
  });

  async function confirmDeleteUser(id, username, fullName) {
    if (typeof Swal !== 'undefined') {
      const result = await Swal.fire({
        title: 'Hapus Pengguna?',
        html: `Apakah Anda yakin ingin menghapus akun pengguna <strong>${username}</strong> (${fullName})?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Ya, Hapus Akun',
        cancelButtonText: 'Batal'
      });

      if (result.isConfirmed) {
        const form = document.getElementById('deleteUserForm');
        form.action = `/admin/users/${id}/delete`;
        form.submit();
      }
    } else {
      if (confirm(`Apakah Anda yakin ingin menghapus akun pengguna "${username}" (${fullName})?`)) {
        const form = document.getElementById('deleteUserForm');
        form.action = `/admin/users/${id}/delete`;
        form.submit();
      }
    }
  }
</script>

<%- include('../layouts/footer') %>
