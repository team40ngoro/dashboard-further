<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/images/cp-logo.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">
  <div class="login-container">
    <div class="login-card">
      <div class="brand-header">
        <img src="/images/cp-logo.png" alt="Logo CP Food Division" class="login-logo-img">
        <h1 class="brand-title">LPP Food Division</h1>
        <p class="brand-subtitle">Sistem Informasi Laporan Pengendalian Produk</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger mb-4" id="login-error-alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/login" method="POST" class="auth-form" id="login-form">
        <div class="form-group mb-3">
          <label for="username" class="form-label">Nama Pengguna (Username)</label>
          <div class="input-wrapper">
            <input type="text" id="username" name="username" class="form-input" value="<%= username %>" placeholder="Masukkan username akun Anda" required autofocus>
          </div>
        </div>

        <div class="form-group mb-4">
          <label for="password" class="form-label">Kata Sandi (Password)</label>
          <div class="input-wrapper">
            <input type="password" id="password" name="password" class="form-input" placeholder="Masukkan kata sandi" required>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" id="btn-login-submit">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
          Masuk ke Sistem
        </button>
      </form>

      <div class="login-footer">
        <div class="demo-hints-header">
          <span class="demo-hints-title">Pilih Akun Demo untuk Masuk Cepat:</span>
        </div>
        <div class="demo-accounts-grid">
          <button type="button" class="demo-btn" onclick="fillLogin('admin.pusat', 'password123')">
            <span class="demo-role">Admin Pusat</span>
            <span class="demo-user">admin.pusat</span>
          </button>
          <button type="button" class="demo-btn" onclick="fillLogin('analis.pusat', 'password123')">
            <span class="demo-role">Analis Pusat</span>
            <span class="demo-user">analis.pusat</span>
          </button>
          <button type="button" class="demo-btn" onclick="fillLogin('uploader.cikande', 'password123')">
            <span class="demo-role">Cabang Cikande</span>
            <span class="demo-user">uploader.cikande</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function fillLogin(u, p) {
      document.getElementById('username').value = u;
      document.getElementById('password').value = p;
      document.getElementById('username').focus();
    }
  </script>
</body>
</html>
