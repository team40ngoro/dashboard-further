<%- include('../layouts/header', { title: title }) %>
<%- include('../layouts/navbar', { activePage: 'branches' }) %>

<main class="main-content">
  <div class="content-header">
    <h1 class="page-title">Manajemen Cabang Produksi</h1>
    <p class="page-subtitle">Kelola seluruh daftar cabang dan PIN otorisasi plant Food Division.</p>
  </div>

  <% if (successMessage) { %>
    <div class="alert alert-success mb-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span><%= successMessage %></span>
    </div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger mb-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span><%= errorMessage %></span>
    </div>
  <% } %>

  <div class="upload-grid">
    <!-- Form Tambah Cabang -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Tambah Cabang Baru</h3>
      </div>
      <div class="card-body">
        <form action="/admin/branches" method="POST">
          <div class="form-group mb-3">
            <label for="code" class="form-label font-semibold">Kode Cabang</label>
            <input type="text" name="code" id="code" class="form-input" placeholder="Contoh: PLM-01" required>
          </div>

          <div class="form-group mb-3">
            <label for="name" class="form-label font-semibold">Nama Pabrik / Cabang</label>
            <input type="text" name="name" id="name" class="form-input" placeholder="Contoh: CPI Food Palembang" required>
          </div>

          <div class="form-group mb-3">
            <label for="city" class="form-label font-semibold">Kota / Wilayah</label>
            <input type="text" name="city" id="city" class="form-input" placeholder="Contoh: Palembang">
          </div>

          <div class="form-group mb-4">
            <label for="accessCode" class="form-label font-semibold">PIN Akses Upload Plant</label>
            <input type="text" name="accessCode" id="accessCode" class="form-input font-mono" placeholder="4 Digit PIN (Default: 1234)" value="1234" required>
            <div class="text-xs text-muted mt-1">Digunakan oleh operator pabrik saat mengunggah laporan Excel.</div>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Simpan Cabang Baru
          </button>
        </form>
      </div>
    </div>

    <!-- Tabel Daftar Cabang -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Daftar Cabang Aktif (<%= branches.length %>)</h3>
      </div>
      <div class="card-body p-0">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Kode</th>
              <th>Nama Cabang</th>
              <th>Kota</th>
              <th>PIN Akses</th>
              <th class="text-center" style="width: 130px;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (branches.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center py-6 text-muted">Belum ada cabang terdaftar.</td>
              </tr>
            <% } %>
            <% branches.forEach(b => { %>
              <tr>
                <td>#<%= b.id %></td>
                <td><span class="badge badge-branch"><%= b.code %></span></td>
                <td class="font-bold"><%= b.name %></td>
                <td><%= b.city || '-' %></td>
                <td><code class="font-bold text-primary"><%= b.access_code || '1234' %></code></td>
                <td>
                  <div class="table-actions-cell justify-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openEditBranchModal(<%= b.id %>, '<%= b.code %>', '<%= b.name.replace(/'/g, "\\'") %>', '<%= (b.city || '').replace(/'/g, "\\'") %>', '<%= b.access_code || '1234' %>')" title="Edit Cabang">
                      Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDeleteBranch(<%= b.id %>, '<%= b.name.replace(/'/g, "\\'") %>', '<%= b.code %>')" title="Hapus Cabang">
                      Hapus
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- Hidden Form for Delete -->
<form id="deleteBranchForm" method="POST" style="display: none;"></form>

<!-- Modal Edit Cabang -->
<div class="modal-backdrop" id="editBranchModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Edit Data Cabang</h3>
      <button type="button" class="modal-close-btn" onclick="closeEditBranchModal()">&times;</button>
    </div>
    <form id="editBranchForm" method="POST">
      <div class="modal-body">
        <div class="form-group mb-3">
          <label for="edit_code" class="form-label font-semibold">Kode Cabang</label>
          <input type="text" name="code" id="edit_code" class="form-input" required>
        </div>

        <div class="form-group mb-3">
          <label for="edit_name" class="form-label font-semibold">Nama Pabrik / Cabang</label>
          <input type="text" name="name" id="edit_name" class="form-input" required>
        </div>

        <div class="form-group mb-3">
          <label for="edit_city" class="form-label font-semibold">Kota / Wilayah</label>
          <input type="text" name="city" id="edit_city" class="form-input">
        </div>

        <div class="form-group mb-2">
          <label for="edit_accessCode" class="form-label font-semibold">PIN Akses Upload Plant</label>
          <input type="text" name="accessCode" id="edit_accessCode" class="form-input font-mono" required>
          <div class="text-xs text-muted mt-1">Operator pabrik wajib memasukkan PIN ini saat mengunggah LPP.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="closeEditBranchModal()">Batal</button>
        <button type="submit" class="btn btn-primary btn-sm">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditBranchModal(id, code, name, city, accessCode) {
    const modal = document.getElementById('editBranchModal');
    const form = document.getElementById('editBranchForm');
    form.action = `/admin/branches/${id}/update`;
    document.getElementById('edit_code').value = code;
    document.getElementById('edit_name').value = name;
    document.getElementById('edit_city').value = city;
    document.getElementById('edit_accessCode').value = accessCode;
    modal.classList.add('active');
  }

  function closeEditBranchModal() {
    const modal = document.getElementById('editBranchModal');
    modal.classList.remove('active');
  }

  // Close modal when clicking backdrop
  document.getElementById('editBranchModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeEditBranchModal();
    }
  });

  async function confirmDeleteBranch(id, name, code) {
    if (typeof Swal !== 'undefined') {
      const result = await Swal.fire({
        title: 'Hapus Cabang?',
        html: `Apakah Anda yakin ingin menghapus cabang <strong>${name} (${code})</strong>?<br><small class="text-muted">Cabang yang memiliki riwayat batch produksi tidak dapat dihapus.</small>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Ya, Hapus Cabang',
        cancelButtonText: 'Batal'
      });

      if (result.isConfirmed) {
        const form = document.getElementById('deleteBranchForm');
        form.action = `/admin/branches/${id}/delete`;
        form.submit();
      }
    } else {
      if (confirm(`Apakah Anda yakin ingin menghapus cabang ${name} (${code})?`)) {
        const form = document.getElementById('deleteBranchForm');
        form.action = `/admin/branches/${id}/delete`;
        form.submit();
      }
    }
  }
</script>

<%- include('../layouts/footer') %>
