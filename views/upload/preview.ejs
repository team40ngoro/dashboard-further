<%- include('../layouts/header', { title: title }) %>
<%- include('../layouts/navbar', { activePage: 'upload' }) %>

<main class="main-content">
  <div class="content-header flex-between">
    <div>
      <h1 class="page-title">Pratinjau Ekstraksi dan Validasi LPP</h1>
      <p class="page-subtitle">Periksa ringkasan data sebelum melakukan konfirmasi penyimpanan permanen ke basis data.</p>
    </div>
    <div class="header-actions">
      <form action="/upload/cancel" method="POST" style="display:inline;">
        <button type="submit" class="btn btn-outline-secondary">Batalkan</button>
      </form>
      <% if (validation.isValid) { %>
        <form action="/upload/commit" method="POST" style="display:inline;">
          <button type="submit" class="btn btn-success" id="btn-confirm-commit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"></path></svg>
            Konfirmasi dan Simpan ke Basis Data
          </button>
        </form>
      <% } else { %>
        <button class="btn btn-disabled" disabled title="Perbaiki kesalahan validasi sebelum menyimpan">
          Simpan Dinonaktifkan (Terdapat Kesalahan)
        </button>
      <% } %>
    </div>
  </div>

  <!-- Validation Status Alerts -->
  <% if (!validation.isValid) { %>
    <div class="alert alert-danger mb-4">
      <div class="alert-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      </div>
      <div>
        <h4 class="font-bold">Ditemukan <%= validation.errors.length %> Kesalahan Validasi:</h4>
        <ul class="alert-list">
          <% validation.errors.forEach(err => { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-success mb-4">
      <div class="alert-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <div>
        <h4 class="font-bold">Validasi Berhasil</h4>
        <p>Format berkas Excel sesuai dengan template LPP FP REV 2 dan siap disimpan untuk cabang: <strong><%= branchName %></strong>.</p>
      </div>
    </div>
  <% } %>

  <% if (validation.warnings && validation.warnings.length > 0) { %>
    <div class="alert alert-warning mb-4">
      <div class="alert-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </div>
      <div>
        <h4 class="font-bold">Catatan Peringatan (<%= validation.warnings.length %>):</h4>
        <ul class="alert-list">
          <% validation.warnings.forEach(warn => { %>
            <li><%= warn %></li>
          <% }) %>
        </ul>
      </div>
    </div>
  <% } %>

  <!-- Summary KPI Cards -->
  <div class="kpi-grid mb-4">
    <div class="kpi-card">
      <div class="kpi-label">Nomor Batch / Lini</div>
      <div class="kpi-value text-primary"><%= batch.identity.batchNumber || '-' %></div>
      <div class="kpi-sub"><%= batch.identity.line %> | <%= branchName %></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Total Bahan Baku (Kg)</div>
      <div class="kpi-value"><%= batch.totalMaterialKg.toLocaleString('id-ID') %> kg</div>
      <div class="kpi-sub"><%= batch.materials.length %> item bahan baku</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Total Output Produk (Kg)</div>
      <div class="kpi-value text-success"><%= batch.outputGoodKg.toLocaleString('id-ID') %> kg</div>
      <div class="kpi-sub"><%= batch.outputs.length %> palet kemasan</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Rasio Rijek Global</div>
      <div class="kpi-value <%= batch.calculatedRejectPct > 3 ? 'text-danger' : 'text-warning' %>">
        <%= batch.calculatedRejectPct %> %
      </div>
      <div class="kpi-sub">Total rijek: <%= batch.totalRejectKg.toLocaleString('id-ID') %> kg</div>
    </div>
  </div>

  <!-- Detail Tables Grid -->
  <div class="preview-sections">
    <!-- Identitas Detail -->
    <div class="card mb-4">
      <div class="card-header">
        <h3 class="card-title">1. Identitas Produksi (Lembar Kerja DEPAN)</h3>
      </div>
      <div class="card-body">
        <div class="info-grid">
          <div class="info-item"><span class="info-label">Nama Produk:</span> <span class="info-val font-bold"><%= batch.identity.productName %></span></div>
          <div class="info-item"><span class="info-label">Kode Produk:</span> <span class="info-val"><%= batch.identity.productCode %></span></div>
          <div class="info-item"><span class="info-label">Tanggal Produksi:</span> <span class="info-val"><%= batch.identity.productionDate %></span></div>
          <div class="info-item"><span class="info-label">Waktu Kerja:</span> <span class="info-val"><%= batch.identity.workHours %> jam</span></div>
          <div class="info-item"><span class="info-label">% Total Meat:</span> <span class="info-val"><%= batch.identity.meatPercentage %>%</span></div>
          <div class="info-item"><span class="info-label">% Rijek Form:</span> <span class="info-val"><%= batch.identity.formRejectPercentage %>%</span></div>
        </div>
      </div>
    </div>

    <!-- Bahan Baku -->
    <div class="card mb-4">
      <div class="card-header">
        <h3 class="card-title">2. Bahan Baku dan Adonan (<%= batch.materials.length %> entri)</h3>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Kategori</th>
                <th>Nama Bahan</th>
                <th>Kode Batch</th>
                <th>Suhu (°C)</th>
                <th class="text-right">Berat (Kg)</th>
              </tr>
            </thead>
            <tbody>
              <% batch.materials.forEach(m => { %>
                <tr>
                  <td><span class="badge badge-category"><%= m.category.replace('_', ' ') %></span></td>
                  <td class="font-medium"><%= m.itemName %></td>
                  <td><code><%= m.batchCode || '-' %></code></td>
                  <td><%= m.temperatureC !== null ? m.temperatureC + ' °C' : '-' %></td>
                  <td class="text-right font-bold"><%= m.weightKg.toLocaleString('id-ID') %></td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="4" class="font-bold">Total Penggunaan Bahan:</td>
                <td class="text-right font-bold text-primary"><%= batch.totalMaterialKg.toLocaleString('id-ID') %> kg</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- Parameter Mesin (EAV) -->
    <div class="card mb-4">
      <div class="card-header">
        <h3 class="card-title">3. Parameter Aktual Mesin dan Kualitas (<%= batch.machineMetrics.length %> parameter)</h3>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Mesin / Area</th>
                <th>Nama Parameter</th>
                <th>Tipe</th>
                <th>Nilai Terbaca</th>
                <th>Satuan</th>
              </tr>
            </thead>
            <tbody>
              <% batch.machineMetrics.forEach(mm => { %>
                <tr>
                  <td class="font-medium"><%= mm.machineName %></td>
                  <td><%= mm.parameterName %></td>
                  <td><span class="badge <%= mm.metricType === 'actual' ? 'badge-actual' : 'badge-setting' %>"><%= mm.metricType %></span></td>
                  <td class="font-bold"><%= mm.valueNumeric !== null ? mm.valueNumeric : mm.valueText %></td>
                  <td><%= mm.unit %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Rijek & Output -->
    <div class="grid-2-cols mb-4">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">4. Rincian Rijek (Cooking dan Packing)</h3>
        </div>
        <div class="card-body p-0">
          <table class="data-table">
            <thead>
              <tr>
                <th>Tahap</th>
                <th>Jenis Rijek</th>
                <th class="text-right">Berat (Kg)</th>
              </tr>
            </thead>
            <tbody>
              <% batch.rejects.forEach(r => { %>
                <tr>
                  <td><span class="badge badge-stage"><%= r.stage %></span></td>
                  <td><%= r.rejectType %></td>
                  <td class="text-right font-bold"><%= r.weightKg %> kg</td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3 class="card-title">5. Output Produk Jadi (Lembar Kerja BELAKANG)</h3>
        </div>
        <div class="card-body p-0">
          <table class="data-table">
            <thead>
              <tr>
                <th>Palet</th>
                <th>Boks</th>
                <th class="text-right">Berat (Kg)</th>
                <th>No. BSTB</th>
              </tr>
            </thead>
            <tbody>
              <% batch.outputs.forEach(o => { %>
                <tr>
                  <td class="font-medium"><%= o.palletNo %></td>
                  <td><%= o.boxCount || '-' %></td>
                  <td class="text-right font-bold text-success"><%= o.weightKg.toLocaleString('id-ID') %> kg</td>
                  <td><code><%= o.bstbNo || '-' %></code></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  const commitBtn = document.getElementById('btn-confirm-commit');
  if (commitBtn) {
    const commitForm = commitBtn.closest('form');
    if (commitForm) {
      commitForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (window.AppAlert) {
          const confirmed = await window.AppAlert.confirm({
            title: 'Konfirmasi Simpan Batch',
            message: 'Apakah Anda yakin data batch sudah sesuai dan ingin menyimpannya ke basis data?',
            icon: 'question',
            confirmText: 'Ya, Simpan ke Basis Data',
            cancelText: 'Periksa Lagi',
            confirmBtnClass: 'btn btn-success'
          });
          if (confirmed) {
            window.AppAlert.loading('Menyimpan Data Batch...', 'Harap tunggu sebentar...');
            commitForm.submit();
          }
        } else {
          commitForm.submit();
        }
      });
    }
  }
</script>

<%- include('../layouts/footer') %>
