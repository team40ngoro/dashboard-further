<%- include('../layouts/header', { title: title }) %>
<%- include('../layouts/navbar', { activePage: 'branches' }) %>

<main class="main-content">
  <div class="content-header">
    <h1 class="page-title">Manajemen Cabang Produksi</h1>
    <p class="page-subtitle">Kelola seluruh daftar cabang dan PIN otorisasi plant Food Division.</p>
  </div>

  <% if (successMessage) { %>
    <div class="alert alert-success mb-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span><%= successMessage %></span>
    </div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger mb-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span><%= errorMessage %></span>
    </div>
  <% } %>

  <div class="upload-grid">
    <!-- Form Tambah Cabang -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Tambah Cabang Baru</h3>
      </div>
      <div class="card-body">
        <form action="/admin/branches" method="POST" id="createBranchForm">
          <div class="form-group mb-3">
            <label for="city" class="form-label font-semibold">Kota / Wilayah Pabrik</label>
            <input type="text" name="city" id="city" class="form-input" placeholder="Contoh: Palembang, Bandung, Medan" required>
            <div class="text-xs text-muted mt-1">Sistem otomatis membuat kode cabang dari singkatan kota ini.</div>
          </div>

          <div class="form-group mb-3">
            <label for="name" class="form-label font-semibold">Nama Pabrik / Cabang</label>
            <input type="text" name="name" id="name" class="form-input" placeholder="Contoh: CPI Food Palembang" required>
          </div>

          <div class="form-group mb-3 p-3 rounded-lg border border-slate-200 bg-slate-50 dark:bg-slate-800/50 dark:border-slate-700">
            <div class="text-xs text-muted font-medium mb-1">Kode Cabang Otomatis (Auto-Generated):</div>
            <div class="flex items-center gap-2">
              <span class="badge badge-branch text-sm font-mono font-bold" id="previewCodeBadge">-</span>
              <span class="text-xs text-slate-500" id="previewCodeNote">Akan di-generate otomatis saat disimpan</span>
            </div>
          </div>

          <div class="form-group mb-4">
            <label for="accessCode" class="form-label font-semibold">PIN Akses Upload Plant</label>
            <input type="text" name="accessCode" id="accessCode" class="form-input font-mono" placeholder="4 Digit PIN (Default: 1234)" value="1234" required>
            <div class="text-xs text-muted mt-1">Digunakan oleh operator pabrik saat mengunggah laporan Excel.</div>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Simpan Cabang Baru
          </button>
        </form>
      </div>
    </div>

    <!-- Tabel Daftar Cabang -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Daftar Cabang Aktif (<%= branches.length %>)</h3>
      </div>
      <div class="card-body p-0">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Kode</th>
              <th>Nama Cabang</th>
              <th>Kota</th>
              <th>PIN Akses</th>
              <th class="text-center" style="width: 130px;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (branches.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center py-6 text-muted">Belum ada cabang terdaftar.</td>
              </tr>
            <% } %>
            <% branches.forEach(b => { %>
              <tr>
                <td>#<%= b.id %></td>
                <td><span class="badge badge-branch"><%= b.code %></span></td>
                <td class="font-bold"><%= b.name %></td>
                <td><%= b.city || '-' %></td>
                <td><code class="font-bold text-primary"><%= b.access_code || '1234' %></code></td>
                <td>
                  <div class="table-actions-cell justify-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openEditBranchModal(<%= b.id %>, '<%= b.code %>', '<%= b.name.replace(/'/g, "\\'") %>', '<%= (b.city || '').replace(/'/g, "\\'") %>', '<%= b.access_code || '1234' %>')" title="Edit Cabang">
                      Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDeleteBranch(<%= b.id %>, '<%= b.name.replace(/'/g, "\\'") %>', '<%= b.code %>')" title="Hapus Cabang">
                      Hapus
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- Hidden Form for Delete -->
<form id="deleteBranchForm" method="POST" style="display: none;"></form>

<!-- Modal Edit Cabang -->
<div class="modal-backdrop" id="editBranchModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Edit Data Cabang</h3>
      <button type="button" class="modal-close-btn" onclick="closeEditBranchModal()">&times;</button>
    </div>
    <form id="editBranchForm" method="POST">
      <div class="modal-body">
        <div class="form-group mb-3">
          <div class="flex items-center justify-between mb-1">
            <label for="edit_code" class="form-label font-semibold mb-0">Kode Cabang</label>
            <button type="button" class="text-xs text-primary font-medium hover:underline border-0 bg-transparent cursor-pointer" onclick="regenerateEditCode()">⚡ Auto-Generate dari Kota</button>
          </div>
          <input type="text" name="code" id="edit_code" class="form-input uppercase font-mono font-bold" required>
        </div>

        <div class="form-group mb-3">
          <label for="edit_city" class="form-label font-semibold">Kota / Wilayah</label>
          <input type="text" name="city" id="edit_city" class="form-input">
        </div>

        <div class="form-group mb-3">
          <label for="edit_name" class="form-label font-semibold">Nama Pabrik / Cabang</label>
          <input type="text" name="name" id="edit_name" class="form-input" required>
        </div>

        <div class="form-group mb-2">
          <label for="edit_accessCode" class="form-label font-semibold">PIN Akses Upload Plant</label>
          <input type="text" name="accessCode" id="edit_accessCode" class="form-input font-mono" required>
          <div class="text-xs text-muted mt-1">Operator pabrik wajib memasukkan PIN ini saat mengunggah LPP.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="closeEditBranchModal()">Batal</button>
        <button type="submit" class="btn btn-primary btn-sm">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script>
  const CITY_ABBR_MAP = {
    cikande: 'CKD', serang: 'SRG', semarang: 'SMG', surabaya: 'SBY', medan: 'MDN',
    jakarta: 'JKT', bandung: 'BDG', palembang: 'PLM', denpasar: 'DPS', makassar: 'MKS',
    yogyakarta: 'YOG', jogja: 'JOG', malang: 'MLG', solo: 'SLO', surakarta: 'SKA',
    bogor: 'BGR', tangerang: 'TGR', bekasi: 'BKS', cirebon: 'CRB', lampung: 'LMP',
    pontianak: 'PTK', banjarmasin: 'BJM', balikpapan: 'BPN', samarinda: 'SMD', manado: 'MND',
    padang: 'PDG', pekanbaru: 'PKU', batam: 'BTM', jambi: 'JMB', bengkulu: 'BKL',
    kupang: 'KPG', ambon: 'AMB', jayapura: 'JPR', mataram: 'MTR', tasikmalaya: 'TSM',
    sidoarjo: 'SDA', sukabumi: 'SKB', salatiga: 'SLT', probolinggo: 'PBG', pasuruan: 'PSR',
    kediri: 'KDR', madiun: 'MDN', blitar: 'BLT', jember: 'JMB', banyuwangi: 'BWX',
    tegal: 'TGL', pekalongan: 'PKL', purwokerto: 'PWT', cilacap: 'CLP', kudus: 'KDS'
  };

  function quickCityAbbr(cityName) {
    if (!cityName) return 'CBG';
    const clean = cityName.trim().toLowerCase().replace(/^(kota|kabupaten|kab\.|kab)\s+/i, '');
    if (CITY_ABBR_MAP[clean]) return CITY_ABBR_MAP[clean];
    const words = clean.split(/[\s-]+/).filter(Boolean);
    if (words.length >= 3) return (words[0][0] + words[1][0] + words[2][0]).toUpperCase();
    const letters = (words[0] || clean).toUpperCase().replace(/[^A-Z]/g, '');
    if (letters.length <= 3) return letters.padEnd(3, 'X');
    const first = letters[0];
    const consonants = letters.slice(1).replace(/[AEIOU]/g, '');
    if (consonants.length >= 2) return (first + consonants.slice(0, 2)).toUpperCase();
    return letters.slice(0, 3).toUpperCase();
  }

  const cityInput = document.getElementById('city');
  const nameInput = document.getElementById('name');
  const previewBadge = document.getElementById('previewCodeBadge');
  const previewNote = document.getElementById('previewCodeNote');

  let debounceTimer;
  function updateAutoCode() {
    const city = (cityInput ? cityInput.value : '').trim();
    const name = (nameInput ? nameInput.value : '').trim();
    if (!city && !name) {
      if (previewBadge) previewBadge.textContent = '-';
      if (previewNote) previewNote.textContent = 'Akan di-generate otomatis saat disimpan';
      return;
    }

    // Instant local preview
    const abbr = quickCityAbbr(city || name.replace(/^CPI\s+(Food\s+)?/i, ''));
    if (previewBadge) previewBadge.textContent = `${abbr}-01`;
    if (previewNote) previewNote.textContent = `Singkatan kota: ${abbr}`;

    // Fetch server for exact collision-free sequence number
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
      try {
        const res = await fetch(`/admin/branches/generate-code?city=${encodeURIComponent(city)}&name=${encodeURIComponent(name)}`);
        const data = await res.json();
        if (data.success && data.code && previewBadge) {
          previewBadge.textContent = data.code;
        }
      } catch (err) {
        console.warn('Auto code fetch fallback error:', err);
      }
    }, 250);
  }

  if (cityInput) cityInput.addEventListener('input', updateAutoCode);
  if (nameInput) {
    nameInput.addEventListener('input', function() {
      if (!cityInput || !cityInput.value.trim()) {
        updateAutoCode();
      }
    });
  }

  async function regenerateEditCode() {
    const city = document.getElementById('edit_city').value.trim();
    const name = document.getElementById('edit_name').value.trim();
    const target = city || name.replace(/^CPI\s+(Food\s+)?/i, '');
    const abbr = quickCityAbbr(target);
    document.getElementById('edit_code').value = `${abbr}-01`;
    try {
      const res = await fetch(`/admin/branches/generate-code?city=${encodeURIComponent(city)}&name=${encodeURIComponent(name)}`);
      const data = await res.json();
      if (data.success && data.code) {
        document.getElementById('edit_code').value = data.code;
      }
    } catch (e) {}
  }

  function openEditBranchModal(id, code, name, city, accessCode) {
    const modal = document.getElementById('editBranchModal');
    const form = document.getElementById('editBranchForm');
    form.action = `/admin/branches/${id}/update`;
    document.getElementById('edit_code').value = code;
    document.getElementById('edit_name').value = name;
    document.getElementById('edit_city').value = city;
    document.getElementById('edit_accessCode').value = accessCode;
    modal.classList.add('active');
  }

  function closeEditBranchModal() {
    const modal = document.getElementById('editBranchModal');
    modal.classList.remove('active');
  }

  document.getElementById('editBranchModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeEditBranchModal();
    }
  });

  async function confirmDeleteBranch(id, name, code) {
    if (typeof Swal !== 'undefined') {
      const result = await Swal.fire({
        title: 'Hapus Cabang?',
        html: `Apakah Anda yakin ingin menghapus cabang <strong>${name} (${code})</strong>?<br><small class="text-muted">Cabang yang memiliki riwayat batch produksi tidak dapat dihapus.</small>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Ya, Hapus Cabang',
        cancelButtonText: 'Batal'
      });

      if (result.isConfirmed) {
        const form = document.getElementById('deleteBranchForm');
        form.action = `/admin/branches/${id}/delete`;
        form.submit();
      }
    } else {
      if (confirm(`Apakah Anda yakin ingin menghapus cabang ${name} (${code})?`)) {
        const form = document.getElementById('deleteBranchForm');
        form.action = `/admin/branches/${id}/delete`;
        form.submit();
      }
    }
  }
</script>

<%- include('../layouts/footer') %>
