<%- include('../layouts/header', { title: title }) %>
<%- include('../layouts/navbar', { activePage: 'batches' }) %>

<main class="main-content">
  <div class="content-header flex-between">
    <div>
      <div class="breadcrumb mb-2">
        <a href="/batches" class="text-muted">← Kembali ke Daftar Batch</a>
      </div>
      <h1 class="page-title">Detail Batch: <%= batch.batch_number %></h1>
      <p class="page-subtitle">Laporan Pengendalian Produk cabang <strong><%= batch.branch_name %></strong> (<%= batch.branch_code %>)</p>
    </div>
    <div class="header-actions">
      <% if (currentUser.role === 'admin_pusat' || (currentUser.role === 'pengunggah_cabang' && currentUser.branch_id === batch.branch_id)) { %>
        <a href="/batches/<%= batch.id %>/edit" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
          Koreksi Data
        </a>
      <% } %>
      <a href="/dashboard" class="btn btn-outline-primary">Lihat di Dashboard</a>
    </div>
  </div>

  <% if (successMessage) { %>
    <div class="alert alert-success mb-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span><%= successMessage %></span>
    </div>
  <% } %>

  <!-- Summary Cards -->
  <div class="kpi-grid mb-4">
    <div class="kpi-card">
      <div class="kpi-label">Produk / Lini</div>
      <div class="kpi-value text-primary font-bold"><%= batch.product_name %></div>
      <div class="kpi-sub"><%= batch.product_code %> | <%= batch.line %></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Total Bahan Baku</div>
      <div class="kpi-value"><%= Number(batch.total_material_kg).toLocaleString('id-ID') %> kg</div>
      <div class="kpi-sub"><%= batch.materials.length %> item bahan baku</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Total Output Produk</div>
      <div class="kpi-value text-success font-bold"><%= Number(batch.output_good_kg).toLocaleString('id-ID') %> kg</div>
      <div class="kpi-sub"><%= batch.outputs.length %> palet pengemasan</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Rasio Rijek</div>
      <div class="kpi-value <%= Number(batch.calculated_reject_pct) > 3 ? 'text-danger' : 'text-warning' %> font-bold">
        <%= batch.calculated_reject_pct %>%
      </div>
      <div class="kpi-sub">Total rijek: <%= Number(batch.total_reject_kg).toLocaleString('id-ID') %> kg</div>
    </div>
  </div>

  <!-- Identitas Batch Card -->
  <div class="card mb-4">
    <div class="card-header">
      <h3 class="card-title">1. Identitas & Header Produksi (DEPAN)</h3>
    </div>
    <div class="card-body">
      <div class="info-grid">
        <div class="info-item"><span class="info-label">Tanggal Produksi:</span> <span class="info-val font-semibold"><%= typeof batch.production_date === 'string' ? batch.production_date.split('T')[0] : (batch.production_date ? batch.production_date.toISOString().split('T')[0] : '-') %></span></div>
        <div class="info-item"><span class="info-label">Line Produksi:</span> <span class="info-val font-semibold"><%= batch.line %></span></div>
        <div class="info-item"><span class="info-label">Waktu Kerja:</span> <span class="info-val"><%= batch.work_hours %> jam</span></div>
        <div class="info-item"><span class="info-label">% Total Meat:</span> <span class="info-val"><%= batch.meat_percentage %>%</span></div>
        <div class="info-item"><span class="info-label">% Rijek Form:</span> <span class="info-val"><%= batch.form_reject_percentage %>%</span></div>
        <div class="info-item"><span class="info-label">Pengunggah / Waktu:</span> <span class="info-val"><%= batch.creator_name || 'System' %> (<%= typeof batch.created_at === 'string' ? batch.created_at.replace('T', ' ').substring(0, 19) : (batch.created_at ? batch.created_at.toISOString().replace('T', ' ').substring(0, 19) : '-') %>)</span></div>
      </div>
    </div>
  </div>

  <!-- Bahan Baku -->
  <div class="card mb-4">
    <div class="card-header">
      <h3 class="card-title">2. Rincian Penggunaan Bahan Baku</h3>
    </div>
    <div class="card-body p-0">
      <table class="data-table">
        <thead>
          <tr>
            <th>Kategori</th>
            <th>Nama Bahan</th>
            <th>Kode Batch</th>
            <th>Suhu (°C)</th>
            <th class="text-right">Berat (Kg)</th>
          </tr>
        </thead>
        <tbody>
          <% batch.materials.forEach(m => { %>
            <tr>
              <td><span class="badge badge-category"><%= m.category.replace('_', ' ') %></span></td>
              <td class="font-medium"><%= m.item_name %></td>
              <td><code><%= m.batch_code || '-' %></code></td>
              <td><%= m.temperature_c !== null ? m.temperature_c + ' °C' : '-' %></td>
              <td class="text-right font-bold"><%= Number(m.weight_kg).toLocaleString('id-ID') %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" class="font-bold">Total Penggunaan Bahan:</td>
            <td class="text-right font-bold text-primary"><%= Number(batch.total_material_kg).toLocaleString('id-ID') %> kg</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- Parameter Mesin (EAV) -->
  <div class="card mb-4">
    <div class="card-header">
      <h3 class="card-title">3. Parameter Aktual Mesin & Kualitas</h3>
    </div>
    <div class="card-body p-0">
      <table class="data-table">
        <thead>
          <tr>
            <th>Mesin / Area</th>
            <th>Nama Parameter</th>
            <th>Tipe</th>
            <th>Nilai</th>
            <th>Satuan</th>
          </tr>
        </thead>
        <tbody>
          <% batch.machineMetrics.forEach(mm => { %>
            <tr>
              <td class="font-medium"><%= mm.machine_name %></td>
              <td><%= mm.parameter_name %></td>
              <td><span class="badge <%= mm.metric_type === 'actual' ? 'badge-actual' : 'badge-setting' %>"><%= mm.metric_type %></span></td>
              <td class="font-bold"><%= mm.value_numeric !== null ? mm.value_numeric : mm.value_text %></td>
              <td><%= mm.unit %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Rijek & Output -->
  <div class="grid-2-cols mb-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">4. Rincian Rijek (Cooking & Packing)</h3>
      </div>
      <div class="card-body p-0">
        <table class="data-table">
          <thead>
            <tr>
              <th>Tahap</th>
              <th>Jenis Rijek</th>
              <th class="text-right">Berat (Kg)</th>
            </tr>
          </thead>
          <tbody>
            <% batch.rejects.forEach(r => { %>
              <tr>
                <td><span class="badge badge-stage"><%= r.stage %></span></td>
                <td><%= r.reject_type %></td>
                <td class="text-right font-bold"><%= Number(r.weight_kg).toLocaleString('id-ID') %> kg</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">5. Output Produk Jadi (Sheet BELAKANG)</h3>
      </div>
      <div class="card-body p-0">
        <table class="data-table">
          <thead>
            <tr>
              <th>Palet</th>
              <th>Boks</th>
              <th class="text-right">Berat (Kg)</th>
              <th>No. BSTB</th>
            </tr>
          </thead>
          <tbody>
            <% batch.outputs.forEach(o => { %>
              <tr>
                <td class="font-medium"><%= o.pallet_no %></td>
                <td><%= o.box_count || '-' %></td>
                <td class="text-right font-bold text-success"><%= Number(o.weight_kg).toLocaleString('id-ID') %> kg</td>
                <td><code><%= o.bstb_no || '-' %></code></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Audit Trail -->
  <div class="card mb-4">
    <div class="card-header">
      <h3 class="card-title">6. Jejak Audit & Koreksi (Audit Trail)</h3>
    </div>
    <div class="card-body p-0">
      <table class="data-table">
        <thead>
          <tr>
            <th>Waktu</th>
            <th>Pengguna</th>
            <th>Aksi</th>
            <th>Keterangan / Perubahan</th>
            <th>IP Address</th>
          </tr>
        </thead>
        <tbody>
          <% if (batch.auditLogs.length === 0) { %>
            <tr>
              <td colspan="5" class="text-center text-muted">Belum ada riwayat perubahan.</td>
            </tr>
          <% } %>
          <% batch.auditLogs.forEach(al => { %>
            <tr>
              <td class="text-xs text-muted"><%= typeof al.created_at === 'string' ? al.created_at.replace('T', ' ').substring(0, 19) : (al.created_at ? al.created_at.toISOString().replace('T', ' ').substring(0, 19) : '-') %></td>
              <td class="font-medium"><%= al.user_name || 'System' %> (<%= al.user_role || '-' %>)</td>
              <td><span class="badge <%= al.action === 'IMPORT_BATCH' ? 'badge-actual' : 'badge-setting' %>"><%= al.action %></span></td>
              <td class="text-sm"><code><%= al.details %></code></td>
              <td class="text-xs text-muted"><%= al.ip_address || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
